// devcontainer-setup: dispatch new panes/tabs into the right container.
// Zellij has no global "default-command" like tmux, so new panes/tabs must
// be explicitly bound to run the dispatcher via the Run/NewTab actions.
// $ZELLIJ_SESSION_NAME (read by dispatch.sh) is set by zellij itself.
//
// "devcontainer" (no path/extension) resolves against zellij's own layout
// directory (~/.config/zellij/layouts/); dispatch.sh is looked up on PATH.
// Both are machine-independent for the same reason: no $HOME hardcoded.
default_layout "devcontainer"

keybinds {
    pane {
        bind "n" { Run "dispatch.sh"; SwitchToMode "Normal"; }
        bind "d" { Run "dispatch.sh" { direction "down"; }; SwitchToMode "Normal"; }
        bind "r" { Run "dispatch.sh" { direction "right"; }; SwitchToMode "Normal"; }
    }
    tab {
        bind "n" { NewTab { layout "devcontainer"; }; SwitchToMode "Normal"; }
    }
    shared_except "locked" {
        bind "Alt n" { Run "dispatch.sh"; }
    }
}
