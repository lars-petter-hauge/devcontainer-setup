// Default layout for devcontainer-setup sessions. Used both as the
// session's default_layout (see config-snippet.kdl) and by the "new tab"
// keybind override, so every new tab's first pane also execs into the
// container instead of opening a plain host shell.
//
// dispatch.sh is referenced by bare name (relies on $HOME/.zellij being on
// PATH) rather than an absolute path, so this file works unmodified
// regardless of the machine's $HOME.
layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane command="dispatch.sh"
    pane size=1 borderless=true {
        plugin location="status-bar"
    }
}
